{
    "version": "2.0",
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        }
    },
    "extensions": {
        "queues": {
            "messageEncoding": "none"
        },
        "durableTask": {
            "hubName": "DurableFunctionsHub"
        }
    },
    "functionTimeout": "00:00:02"
}