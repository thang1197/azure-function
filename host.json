{
    "version": "2.0",
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        }
    },
    "extensions": {
        "queues": {
            "messageEncoding": "none"
        },
        "http": {
            "routePrefix": "api/v1"
        }
    },
    "functionTimeout": "00:04:00"
}